{
  "name": "nuxt-conf",
  "version": "1.1.0",
  "description": "Load environment-specific TypeScript configuration into Nuxt appConfig, runtimeConfig, and module options.",
  "keywords": [
    "config",
    "runtimeConfig",
    "appConfig",
    "environment-config",
    "typescript-config",
    "cdn",
    "nuxt",
    "nuxt-module"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yisibell/nuxt-conf.git"
  },
  "homepage": "https://github.com/yisibell/nuxt-conf",
  "bugs": {
    "url": "https://github.com/yisibell/nuxt-conf/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "elenh",
    "email": "yisiwings@163.com"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "default": "./dist/module.mjs"
    },
    "./*": [
      "./*",
      "./*.d.ts"
    ]
  },
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "release:lint:test": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@nuxt/kit": "^3.16.0",
    "defu": "^6.1.7",
    "jiti": "^2.7.0",
    "lodash-es": "^4.18.1",
    "ohash": "^2.0.12",
    "ufo": "^1.6.4"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "1.16.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^3.16.0",
    "@nuxt/test-utils": "^3.15.4",
    "@types/lodash-es": "^4.17.12",
    "changelogen": "~0.5.7",
    "cross-env": "^7.0.3",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "9.39.4",
    "eslint-plugin-format": "2.0.1",
    "eslint-plugin-regexp": "3.1.1",
    "nuxt": "^3.16.0",
    "sass": "1.101.7",
    "typescript": "^5.8.3",
    "vitest": "^3.0.3",
    "vue-tsc": "^2.2.0"
  }
}